@using PersonalWebsite.Models.Faq
@model IReadOnlyList<FaqItem>
@{
    ViewData["Title"] = "FAQ | Low JianKhai";
}

<h1>FAQ</h1>
<p class="subtitle">Common questions and quick answers.</p>

<section class="accordion" aria-label="Frequently asked questions">
    @foreach (var faq in Model)
    {
        <details class="accordion-item">
            <summary><span>@faq.Question</span></summary>
            @Html.Raw(faq.AnswerHtml)
        </details>
    }
</section>

<aside class="contact-card" aria-labelledby="contact-title">
    <h2 id="contact-title">Didn't find your answer?</h2>
    <p>Feel free to reach out to me directly.</p>
    <div class="contact-actions">
        <a class="contact-button" href="https://mail.google.com/mail/?view=cm&fs=1&to=lowjiankhai@gmail.com" target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="5" width="18" height="14" rx="3" />
                <path d="m3.5 7 8.5 6 8.5-6" />
            </svg>
            Email me
        </a>
        <a class="contact-button contact-button-outline" href="https://www.linkedin.com/in/jiankhai-low-479344166/" target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="3" width="18" height="18" rx="3" />
                <path d="M8 10v6M8 7.5v.01M12 16v-6M12 12.5a2.5 2.5 0 0 1 5 0V16" />
            </svg>
            LinkedIn
        </a>
    </div>
    <p class="contact-address">
        Or copy my email:
        <button type="button" class="copy-button" data-copy-text="lowjiankhai@gmail.com" aria-live="polite">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="9" y="9" width="12" height="12" rx="2" />
                <path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1" />
            </svg>
            <span class="copy-label">lowjiankhai@gmail.com</span>
        </button>
    </p>
</aside>

@section Scripts {
    <script src="~/js/faq/copy-email.js" asp-append-version="true"></script>
}
